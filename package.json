{
  "name": "shelflife",
  "version": "0.7.1",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:mock": "set SHELFLIFE_MOCK=1&& tauri dev",
    "build": "vite build",
    "build:no-bundle": "tauri build --no-bundle",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "cargo:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "cargo:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "cargo:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "cargo:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "validate": "pnpm format:check && pnpm lint && pnpm check",
    "test": "pnpm cargo:test",
    "verify": "pnpm validate && pnpm cargo:fmt:check && pnpm cargo:clippy && pnpm test",
    "i18n:audit": "node scripts/audit-i18n.mjs",
    "tauri": "tauri",
    "tauri:dev:withidentity": "cargo build --manifest-path src-tauri/Cargo.toml && (if not exist dist mkdir dist) && copy /Y src-tauri\\target\\debug\\shelflife.exe dist\\ >nul && winapp run .\\dist",
    "pack:msix": "pnpm tauri build --no-bundle && (if not exist dist mkdir dist) && copy /Y src-tauri\\target\\release\\shelflife.exe dist\\ >nul && winapp pack .\\dist --cert .\\devcert.pfx",
    "prepare": "husky"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@lucide/svelte": "^1.22.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.68.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.11.3",
    "@types/node": "^26.0.1",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^4.1.1",
    "shadcn-svelte": "^1.3.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0"
  }
}
