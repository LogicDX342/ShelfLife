{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShelfLife",
  "version": "../package.json",
  "identifier": "com.shelflife.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ShelfLife",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "resizable": true
      },
      {
        "label": "dropzone",
        "title": "ShelfLife Dropzone",
        "url": "/dropzone",
        "width": 360,
        "height": 300,
        "minWidth": 360,
        "minHeight": 300,
        "maxWidth": 360,
        "maxHeight": 300,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {}
}
